# Copy to .env and fill in. Never commit .env.
FINVIZ_AUTH=your_finviz_elite_auth_key
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Optional
PDUFA_API_KEY=                 # free key raises quota to 10k/month; leave blank for anonymous
EDGAR_USER_AGENT=ApexMarketSniper lakhbeer@example.com   # SEC requires a contact in the UA
DB_PATH=data/sniper.db
LOG_LEVEL=INFO

# Polling (minutes) during US market hours
INTRADAY_POLL_MINUTES=2
# Catalyst radar window (days ahead)
CATALYST_WINDOW_DAYS=30
